{
  "expo": {
    "name": "foodpanda-clone",
    "slug": "foodpanda-clone",
    "scheme": "foodpanda-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodpanda.clone",
      "config": {
        "googleMapsApiKey": "AIzaSyD8_FOODPANDA_LIVE_MAPS_IOS_KEY_2026"
      }
    },
    "android": {
      "package": "com.foodpanda.clone",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB9_FOODPANDA_LIVE_MAPS_ANDROID_KEY_2026"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "react-native-maps",
        {
          "apiKey": "AIzaSyB9_FOODPANDA_LIVE_MAPS_ANDROID_KEY_2026"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
