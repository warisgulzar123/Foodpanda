# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/foodpanda_db?retryWrites=true&w=majority

# Google Maps API Key for native maps & geocoding
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Custom backend API URL (Leave blank on Vercel for same-origin serverless routing)
EXPO_PUBLIC_API_URL=

# Port for local development
PORT=5000
NODE_ENV=development
